APP_NAME=OpenReferral
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=openreferral
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Emails and push are queued so API responses stay fast.
# Run `php artisan queue:work` alongside the app (or set this to `sync` locally).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes emails to storage/logs/laravel.log — fine for local work.
# Point this at real SMTP (or Postmark/SES/Resend) before going live.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@openreferral.us"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Push notifications — Firebase Cloud Messaging (Android + iOS via APNs)
# ---------------------------------------------------------------------------
# Preferred: HTTP v1. Download the service-account JSON from
# Firebase console → Project settings → Service accounts → Generate new key,
# save it outside the web root, and point FCM_CREDENTIALS at it
# (absolute path, or relative to the project root).
FCM_CREDENTIALS=

# Legacy fallback (Cloud Messaging API "Server key"). Only used when
# FCM_CREDENTIALS is empty. With neither set, pushes are logged and skipped —
# in-app notifications and emails still work.
FCM_SERVER_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
